{
  "name": "dsh-pearl-oracle",
  "version": "0.1.2",
  "description": "Pearl Oracle — a dark skin for DeepSeek Harness: a warm grey stone / pearl white / silver / misty blue palette with a full pearl banner on the new-session page",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "skin",
    "theme",
    "pearl",
    "editorial",
    "dark"
  ],
  "license": "MIT",
  "author": "Science Roam Limited",
  "homepage": "https://github.com/keman-ai/dsh-skin-pack/tree/main/packages/dsh-pearl-oracle#readme",
  "bugs": {
    "url": "https://github.com/keman-ai/dsh-skin-pack/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keman-ai/dsh-skin-pack.git",
    "directory": "packages/dsh-pearl-oracle"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "skin.json",
    "preview",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "tsc --noEmit",
    "prepublishOnly": "tsdown"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
