{
  "name": "dsh-night-swing",
  "version": "0.1.0",
  "description": "夜色秋千 —— DeepSeek Harness 的暗色皮肤：雨夜蓝 / 战斗红 / 霓虹青配色 + 新会话页整幅雨夜横幅",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "skin",
    "theme",
    "neon",
    "city",
    "night",
    "dark"
  ],
  "license": "MIT",
  "author": "Science Roam Limited",
  "homepage": "https://github.com/keman-ai/dsh-night-swing#readme",
  "bugs": {
    "url": "https://github.com/keman-ai/dsh-night-swing/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keman-ai/dsh-night-swing.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "skin.json",
    "preview",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "tsc --noEmit",
    "prepublishOnly": "tsdown"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
